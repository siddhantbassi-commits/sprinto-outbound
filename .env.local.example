# Copy to .env.local (never commit the real file). Keys are entered through your host's hidden prompt, never pasted into chat.

# --- Supabase (Settings > API). The anon key is public by design; the database's own rules protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- The scheduler's own login. Invite it in Supabase, then: update public.profiles set role = 'worker' where email = '...';
WORKER_EMAIL=
WORKER_PASSWORD=

# --- A long random string (24+ characters). Also set as the CRON_SECRET repository secret, with APP_URL, for the Worker workflow.
CRON_SECRET=
APP_URL=

# --- Gemini. GEMINI_MODEL is optional and pins one model; leave it empty to use the built-in chain.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Hunter (optional: without it only hand-picked contacts work)
HUNTER_API_KEY=

# --- Gmail, send-only OAuth. OUTBOUND_TEST_TO is the ONLY address test mode can mail; it must match the address in Settings.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=
GMAIL_FROM_NAME=
OUTBOUND_TEST_TO=
# Named in the scraper's user agent so a site owner can reach you. Defaults to OUTBOUND_TEST_TO.
OUTBOUND_CONTACT_EMAIL=

# --- Demo mode: sample companies, a pretend model, no keys. Ignored if Supabase is configured or this is a production deploy.
# DEMO_MODE=1

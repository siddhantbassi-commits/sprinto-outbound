{
  "name": "sprinto-outbound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sprinto Outbound: scrape, qualify, find the person, draft and send a cold email. Gemini reads and writes; code decides.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "DEMO_MODE=1 NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_ANON_KEY= WORKER_EMAIL= WORKER_PASSWORD= GEMINI_API_KEY= CRON_SECRET= NEXT_DIST_DIR=.next-demo next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "smoke": "tsx scripts/smoke.ts",
    "golden": "tsx scripts/golden.ts",
    "keys": "tsx scripts/keys.ts",
    "gmail-token": "tsx scripts/gmail-token.ts",
    "guest": "tsx scripts/guest-setup.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  }
}
